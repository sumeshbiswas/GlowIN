<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Premium skincare products for healthy, radiant skin." />
    <meta name="keywords" content="skincare, beauty, cosmetics, face care, skincare products" />
    <title>@ViewData["Title"] - GlowIN</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Bootstrap 5.3.8 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous">

    <!-- Bootstrap Icons 1.13.1 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/homepage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/banner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/glowinbenefits.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/glowinabout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/glowin-cart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
</head>
<body>
    
     <!-- GLOWIN PREMIUM HERBAL LOADER -->
    <div class="glowinloader" id="glowinloader" aria-hidden="false">
        <div class="glowinloader__content">
            <div class="glowinloader__brand">
                Glow<span>IN</span>
            </div>
            <div class="glowinloader__visual">

                <!-- Circular Botanical Orbit -->
                <div class="glowinloader__orbit">

                    <!-- Orbit Leaf -->
                    <div class="glowinloader__leaf">
                        <i class="bi bi-leaf-fill"></i>
                    </div>

                </div>


                <!-- Decorative Inner Circle -->
                <div class="glowinloader__inner-circle"></div>


                <!-- People -->
                <div class="glowinloader__people">


                    <!-- =========================
                         WOMAN
                         ========================= -->

                    <div class="glowinloader__person glowinloader__woman">

                        <div class="glowinloader__hair"></div>

                        <div class="glowinloader__head">

                            <div class="glowinloader__face"></div>

                        </div>

                        <div class="glowinloader__neck"></div>

                        <div class="glowinloader__body"></div>

                    </div>


                    <!-- =========================
                         MAN
                         ========================= -->

                    <div class="glowinloader__person glowinloader__man">

                        <div class="glowinloader__hair"></div>

                        <div class="glowinloader__head">

                            <div class="glowinloader__face"></div>

                        </div>

                        <div class="glowinloader__neck"></div>

                        <div class="glowinloader__body"></div>

                    </div>


                </div>


                <!-- Botanical Glow -->
                <div class="glowinloader__glow"></div>

            </div>


            <!-- Loading Text -->

            <div class="glowinloader__message">
                Naturally beautiful
            </div>

            <div class="glowinloader__submessage">
                Preparing your botanical experience
            </div>


            <!-- Progress -->

            <div class="glowinloader__progress">

                <span></span>

            </div>

        </div>

    </div>

    <!-- =========================================================
     GLOWIN HOMEPAGE HEADER
     ========================================================= -->

    <header class="glowinhomepage-header">

        <nav class="glowinhomepage-navbar">

            <div class="glowinhomepage-container">

                <a class="glowinhomepage-brand" href="/">
                    <span class="glowinhomepage-brand-main">Glow</span>
                    <span class="glowinhomepage-brand-accent">IN</span>
                </a>

                <div class="glowinhomepage-navigation">

                    <a class="glowinhomepage-nav-link active" href="/">
                        Home
                    </a>

                    <a class="glowinhomepage-nav-link"
                       href="#about">
                        About
                    </a>

                    <a class="glowinhomepage-nav-link"
                       href="#products">
                        Products
                    </a>

                    <a class="glowinhomepage-nav-link"
                       href="#benefits">
                        Benefits
                    </a>

                    <a class="glowinhomepage-nav-link"
                       href="#contact">
                        Contact
                    </a>

                </div>

                <div class="glowinhomepage-actions">

                    <a class="glowinhomepage-icon-button"
                       href="#search"
                       aria-label="Search">
                        <i class="bi bi-search"></i>
                    </a>

                    <a class="glowinhomepage-icon-button"
                       href="#account"
                       aria-label="Account">
                        <i class="bi bi-person"></i>
                    </a>

                    <a class="glowinhomepage-cta"
                       href="#products">

                        Explore
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

                <button class="glowinhomepage-mobile-toggle"
                        type="button"
                        aria-label="Open navigation"
                        aria-expanded="false"
                        aria-controls="glowinhomepageMobileMenu">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>

            </div>

        </nav>


        <div class="glowinhomepage-mobile-menu"
             id="glowinhomepageMobileMenu">

            <div class="glowinhomepage-mobile-menu-inner">

                <a class="glowinhomepage-mobile-link"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>

                <a class="glowinhomepage-mobile-link"
                   href="#about">
                    About
                </a>

                <a class="glowinhomepage-mobile-link"
                   href="#products">
                    Products
                </a>

                <a class="glowinhomepage-mobile-link"
                   href="#benefits">
                    Benefits
                </a>

                <a class="glowinhomepage-mobile-link"
                   href="#contact">
                    Contact
                </a>

                <a class="glowinhomepage-mobile-cta"
                   href="#products">

                    Explore Products
                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </header>


    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- =========================================================
      GLOWIN PREMIUM FOOTER
      ========================================================= -->

    <footer class="glowinfooter">

        <!-- Decorative Botanical Elements -->
        <div class="glowinfooter__decoration glowinfooter__decoration--left">
            <i class="bi bi-leaf-fill"></i>
        </div>

        <div class="glowinfooter__decoration glowinfooter__decoration--right">
            <i class="bi bi-leaf-fill"></i>
        </div>


        <div class="glowinfooter__container">

            <!-- =====================================================
                 MAIN FOOTER
                 ===================================================== -->

            <div class="glowinfooter__main">

                <!-- BRAND -->
                <div class="glowinfooter__brand-column">

                    <a href="/" class="glowinfooter__brand">
                        <span class="glowinfooter__brand-main">Glow</span><span class="glowinfooter__brand-accent">IN</span>
                    </a>

                    <p class="glowinfooter__description">
                        Naturally beautiful skincare,
                        thoughtfully crafted with botanical
                        ingredients for healthy, radiant skin.
                    </p>

                    <div class="glowinfooter__social">

                        <a href="#"
                           class="glowinfooter__social-link"
                           aria-label="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#"
                           class="glowinfooter__social-link"
                           aria-label="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#"
                           class="glowinfooter__social-link"
                           aria-label="Pinterest">
                            <i class="bi bi-pinterest"></i>
                        </a>

                        <a href="#"
                           class="glowinfooter__social-link"
                           aria-label="YouTube">
                            <i class="bi bi-youtube"></i>
                        </a>

                    </div>

                </div>


                <!-- SHOP -->
                <div class="glowinfooter__column">

                    <h3 class="glowinfooter__title">
                        Shop
                    </h3>

                    <ul class="glowinfooter__links">

                        <li>
                            <a href="#products">
                                All Products
                            </a>
                        </li>

                        <li>
                            <a href="#products">
                                Face Care
                            </a>
                        </li>

                        <li>
                            <a href="#products">
                                Body Care
                            </a>
                        </li>

                        <li>
                            <a href="#products">
                                Best Sellers
                            </a>
                        </li>

                        <li>
                            <a href="#products">
                                New Arrivals
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- INFORMATION -->
                <div class="glowinfooter__column">

                    <h3 class="glowinfooter__title">
                        Explore
                    </h3>

                    <ul class="glowinfooter__links">

                        <li>
                            <a href="#about">
                                About GlowIN
                            </a>
                        </li>

                        <li>
                            <a href="#benefits">
                                Our Ingredients
                            </a>
                        </li>

                        <li>
                            <a href="#benefits">
                                Skin Benefits
                            </a>
                        </li>

                        <li>
                            <a href="#contact">
                                Contact Us
                            </a>
                        </li>

                        <li>
                            <a asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy Policy
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- CONTACT -->
                <div class="glowinfooter__column glowinfooter__contact-column">

                    <h3 class="glowinfooter__title">
                        Get in Touch
                    </h3>

                    <div class="glowinfooter__contact">

                        <a href="mailto:hello@glowin.com"
                           class="glowinfooter__contact-item">

                            <span class="glowinfooter__contact-icon">
                                <i class="bi bi-envelope"></i>
                            </span>

                            <span>
                                hello@glowin.com
                            </span>

                        </a>


                        <a href="tel:+919876543210"
                           class="glowinfooter__contact-item">

                            <span class="glowinfooter__contact-icon">
                                <i class="bi bi-telephone"></i>
                            </span>

                            <span>
                                +91 98765 43210
                            </span>

                        </a>


                        <div class="glowinfooter__contact-item">

                            <span class="glowinfooter__contact-icon">
                                <i class="bi bi-clock"></i>
                            </span>

                            <span>
                                Mon – Sat<br>
                                9:00 AM – 6:00 PM
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 NEWSLETTER STRIP
                 ===================================================== -->

            <div class="glowinfooter__newsletter">

                <div class="glowinfooter__newsletter-content">

                    <span class="glowinfooter__newsletter-label">
                        STAY NATURALLY GLOWING
                    </span>

                    <h3 class="glowinfooter__newsletter-title">
                        Get skincare tips &amp; exclusive offers.
                    </h3>

                </div>


                <form class="glowinfooter__newsletter-form">

                    <div class="glowinfooter__input-wrapper">

                        <i class="bi bi-envelope"></i>

                        <input type="email"
                               class="glowinfooter__input"
                               placeholder="Enter your email"
                               aria-label="Email address"
                               required />

                    </div>

                    <button type="submit"
                            class="glowinfooter__subscribe">

                        Subscribe

                        <i class="bi bi-arrow-right"></i>

                    </button>

                </form>

            </div>


            <!-- =====================================================
                 BOTTOM BAR
                 ===================================================== -->

            <div class="glowinfooter__bottom">

                <p class="glowinfooter__copyright">
                    © 2026 GlowIN. All rights reserved.
                </p>


                <div class="glowinfooter__legal">

                    <a href="#">
                        Privacy Policy
                    </a>

                    <span></span>

                    <a href="#">
                        Terms of Use
                    </a>

                    <span></span>

                    <a href="#">
                        Shipping
                    </a>

                    <span></span>

                    <a href="#">
                        Returns
                    </a>

                </div>

            </div>

        </div>

    </footer>

    <!-- =========================================================
     GLOWIN FLOATING BUTTONS
     ========================================================= -->

    <div class="glowinhomepage-floating">

        <!-- Shopping Cart -->

        <button type="button"
                class="glowinhomepage-floating-cart"
                id="glowinhomepageCart">

            <i class="bi bi-bag-fill"></i>

            <span class="glowinhomepage-cart-count"
                  id="glowinhomepageCartCount">

                0

            </span>

        </button>


        <!-- Scroll To Top -->

        <button type="button"
                class="glowinhomepage-scroll-top"
                id="glowinhomepageScrollTop"
                aria-label="Back to top">

            <i class="bi bi-arrow-up"></i>

        </button>

    </div>



    <script src="~/js/product-details.js" asp-append-version="true"></script>
    <script src="~/js/glowin-cart.js" asp-append-version="true"></script>

    <script>
           /* =========================================================
           GLOWIN HOMEPAGE MOBILE NAVIGATION
           ========================================================= */

        (function () {

            "use strict";

            const toggle =
                document.querySelector(
                    ".glowinhomepage-mobile-toggle"
                );

            const menu =
                document.getElementById(
                    "glowinhomepageMobileMenu"
                );

            if (!toggle || !menu) {
                return;
            }


            toggle.addEventListener("click", function () {

                const isOpen =
                    menu.classList.toggle(
                        "glowinhomepage-menu-open"
                    );

                toggle.classList.toggle(
                    "glowinhomepage-toggle-active",
                    isOpen
                );

                toggle.setAttribute(
                    "aria-expanded",
                    isOpen ? "true" : "false"
                );

                toggle.setAttribute(
                    "aria-label",
                    isOpen
                        ? "Close navigation"
                        : "Open navigation"
                );

            });


            /*
             * Close mobile navigation
             * after selecting a menu item.
             */

            const mobileLinks =
                menu.querySelectorAll(
                    ".glowinhomepage-mobile-link, " +
                    ".glowinhomepage-mobile-cta"
                );


            mobileLinks.forEach(function (link) {

                link.addEventListener("click", function () {

                    menu.classList.remove(
                        "glowinhomepage-menu-open"
                    );

                    toggle.classList.remove(
                        "glowinhomepage-toggle-active"
                    );

                    toggle.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                    toggle.setAttribute(
                        "aria-label",
                        "Open navigation"
                    );

                });

            });


            /*
             * Close menu when resizing
             * back to desktop.
             */

            window.addEventListener(
                "resize",
                function () {

                    if (window.innerWidth > 767) {

                        menu.classList.remove(
                            "glowinhomepage-menu-open"
                        );

                        toggle.classList.remove(
                            "glowinhomepage-toggle-active"
                        );

                        toggle.setAttribute(
                            "aria-expanded",
                            "false"
                        );

                        toggle.setAttribute(
                            "aria-label",
                            "Open navigation"
                        );

                    }

                }
            );

        })();

                /* =========================================================
           GLOWIN FLOATING ACTIONS
           ========================================================= */

        document.addEventListener("DOMContentLoaded", function () {

            const scrollTopBtn =
                document.getElementById("glowinhomepageScrollTop");

            const cartCount =
                document.getElementById("glowinhomepageCartCount");


            /* ---------------------------------
               Scroll To Top
            ---------------------------------- */

            window.addEventListener("scroll", function () {

                if (window.scrollY > 300) {

                    scrollTopBtn.classList.add(
                        "glowinhomepage-scroll-visible"
                    );

                } else {

                    scrollTopBtn.classList.remove(
                        "glowinhomepage-scroll-visible"
                    );

                }

            });


            scrollTopBtn.addEventListener("click", function () {

                window.scrollTo({
                    top: 0,
                    behavior: "smooth"
                });

            });


            /* ---------------------------------
               Cart Count (Temporary)
            ---------------------------------- */

            let count = 0;

            document.querySelectorAll(".glowinproducts__add-bag")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        count++;

                        cartCount.textContent = count;

                        cartCount.animate(
                            [
                                { transform: "scale(1)" },
                                { transform: "scale(1.3)" },
                                { transform: "scale(1)" }
                            ],
                            {
                                duration: 300
                            }
                        );

                    });

                });

        });

        </script>

    <!-- Bootstrap 5.3.8 JavaScript -->
    <!-- Includes Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>

    <!-- Your Custom JavaScript -->
    <script src="~/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
